# Configure em: Netlify > Site configuration > Environment variables
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# Opcional: toca vídeos do YouTube dentro do painel (YouTube Data API v3)
YOUTUBE_API_KEY=

# Opcionais
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
GROQ_MODEL=openai/gpt-oss-120b

# [TV-SMARTTHINGS] Controle da TV Samsung (veja docs/TV_SMARTTHINGS.md)
TV_ACCESS_KEY=
SMARTTHINGS_DEVICE_ID=
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REFRESH_TOKEN=
# Apps extras da TV (opcional): TV_APPS_JSON={"nome do app":"id"}
# Alternativa só para testes (expira em 24 h): SMARTTHINGS_TOKEN=

# [PHOTO] Modelo de visão da Groq (opcional)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
